# dependencies
/node_modules
/.pnp
.pnp.js

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# typescript
*.tsbuildinfo
next-env.d.ts

# env
# .env itself (not just .env.local variants) is a supported GITHUB_TOKEN
# source for scripts/gen-*.mjs (see loadToken() in each) — review round 1
# finding #3 found it wasn't ignored, so an ordinary `.env` + `git add -A`
# could have committed a live token.
.env
.env*.local

# OpenNext
.open-next

# playwright artifacts
/test-results/
/playwright-report/

# wrangler files
.wrangler
.dev.vars*
!.dev.vars.example

# Resume: fetched at build time from the private source repo in config/resume.source.json
# (scripts/gen-resume-source.mjs) — NOT committed here. The parsed lib/resume-data.json
# stays committed so `next dev` and typecheck work without a fetch.
/public/resume.tex
/public/resume.pdf
# LaTeX byproducts from the optional local latexmk recompile.
/public/resume.aux
/public/resume.fdb_latexmk
/public/resume.fls
/public/resume.log
/public/resume.out
/public/resume.synctex.gz

# NOT ignored: /public/blog/ and /public/projects/ are committed next to the
# lib/*-data.json that points at them. Only `predev` runs gen-*-data.mjs, so
# build/preview/deploy/CI never fetch — ignoring the images made every one of
# them ship /projects/<slug>/*.png paths with no file behind them (404 live).
# `npm run dev` refreshes images + JSON together; commit both.

# Build ID: generated at build/dev startup (next.config.mjs) for the stale-tab
# reload guard. The deployed /build-id.json is revalidated (see public/_headers).
/public/build-id.json

# VLA embedding assets copied from node_modules/mini-vla/assets/ on predev/
# prebuild (scripts/copy-vla-assets.mjs). The mini-vla package is their source
# of truth.
/public/vla/

# Drop-in portfolio/ folders staged for the project repos (copy out, then delete)
portfolio-staging/
mockups/

# Conductor workspace scratch (see .context/)
.conductor/
